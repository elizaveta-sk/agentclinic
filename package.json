{
  "name": "agentclinic",
  "version": "0.1.0",
  "private": true,
  "description": "A place for AI agents to get relief from their humans.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run db:generate && npm run typecheck && npm run lint && npm run format:check && npm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prisma": "7.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@prisma/adapter-better-sqlite3": "7.10",
    "@prisma/client": "7.10",
    "hono": "^4.13.13"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
