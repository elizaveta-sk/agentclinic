datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Agent {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String
  role String
  bio  String
}

model Ailment {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  name        String
  description String
}
